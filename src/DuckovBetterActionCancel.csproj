<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<DuckovPath>D:\Steam\steamapps\common\Escape from Duckov</DuckovPath>
		<SubPath>\Duckov_Data\Managed\</SubPath>
		<Authors>Aile72</Authors>
		<Version>1.0.2.0</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<Copyright>Copyright (c) 2026 Aile72. All rights reserved.</Copyright>
		<RepositoryUrl>https://github.com/Aile72/DuckovBetterActionCancel</RepositoryUrl>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(DuckovPath)$(SubPath)TeamSoda.*.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovPath)$(SubPath)ItemStatsSystem.dll">
			<Private>False</Private>
		</Reference>
		<Reference Include="$(DuckovPath)$(SubPath)Unity*.dll">
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.4.1" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<None Update="info.ini" CopyToOutputDirectory="PreserveNewest" />
		<None Update="preview.png" CopyToOutputDirectory="PreserveNewest" />
		<None Include="$(PkgLib_Harmony)\lib\net472\0Harmony.dll" Link="0Harmony.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="ReportModOutput" AfterTargets="Build">
		<Message Importance="high" Text="Mod output directory: $(TargetDir)" />
		<Message Importance="high" Text="  $(TargetName).dll" Condition="Exists('$(TargetDir)$(TargetName).dll')" />
		<Message Importance="high" Text="  info.ini" Condition="Exists('$(TargetDir)info.ini')" />
		<Message Importance="high" Text="  preview.png" Condition="Exists('$(TargetDir)preview.png')" />
		<Message Importance="high" Text="  0Harmony.dll" Condition="Exists('$(TargetDir)0Harmony.dll')" />
	</Target>
</Project>
